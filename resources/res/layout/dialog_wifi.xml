<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/shape_blue_black"
    android:padding="@dimen/padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/title_text_size"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/wifi_dialog_ssid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/linear_connect"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/wifi_dialog_pwd"
            android:background="@drawable/shape_blue_transparent"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="12dp"
            android:hint="@string/wifi_please_input_pwd"
            android:cursorVisible="true"
            android:maxLines="1"
            android:singleLine="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="40dp">
            <Button
                android:textSize="@dimen/title_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/wifi_connect"
                android:background="@drawable/shape_btn"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/wifi_connect"/>
            <Button
                android:textSize="@dimen/title_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/wifi_cancel"
                android:background="@drawable/shape_btn"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="50dp"
                android:text="@string/wifi_cancel"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linear_prompt"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="40dp">
            <Button
                android:textSize="@dimen/title_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_cancel_save"
                android:background="@drawable/shape_btn"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/wifi_cancel_save"/>
            <Button
                android:textSize="@dimen/title_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_disconnect"
                android:background="@drawable/shape_btn"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="30dp"
                android:text="@string/wifi_disconnect"/>
            <Button
                android:textSize="@dimen/title_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_cancel"
                android:background="@drawable/shape_btn"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="30dp"
                android:text="@string/wifi_cancel"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
