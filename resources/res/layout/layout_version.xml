<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@android:color/black"
    android:padding="@dimen/padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="@drawable/shape_blue_transparent"
        android:padding="10dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/os_version_message"/>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/tv_upgrade_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text=""/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_hide"
                android:background="@drawable/shape_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hide"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_check"
                android:background="@drawable/shape_btn"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/check_version"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_download"
                android:background="@drawable/shape_btn"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_download"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_upgrade"
                android:background="@drawable/shape_btn"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_upgrade"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/linear_version_right"
        android:background="@drawable/shape_blue_transparent"
        android:padding="10dp"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/tv_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/tv_task_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@android:color/holo_red_light"
            android:id="@+id/tv_task_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/linear_progress"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">
            <TextView
                android:textSize="@dimen/normal_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/tv_upgrade_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"/>
            <ProgressBar
                android:id="@+id/upgrade_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:max="100"
                android:progress="10"
                android:layout_weight="100"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
